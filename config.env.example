#!/usr/bin/env bash
# =============================================================================
# config.env — User-configurable variables for the setup script
# =============================================================================
# Edit these values before running setup.sh. All are optional — sensible
# defaults are provided. Feature flags let you skip components you don't need.
# =============================================================================

# -----------------------------------------------------------------------------
# Feature Flags — set to "false" to skip a component
# -----------------------------------------------------------------------------
INSTALL_NVIDIA=true
INSTALL_DOCKER=true
INSTALL_NVIDIA_CONTAINER_TOOLKIT=true
INSTALL_OLLAMA=true
INSTALL_NODE=true
INSTALL_OPENCLAW=true
INSTALL_TAILSCALE=true
INSTALL_LLMFIT=true
INSTALL_VLLM=true
INSTALL_VSCODE=true
INSTALL_TERMINATOR=true
INSTALL_NOMACHINE=true
INSTALL_PORTAINER=true
INSTALL_GPU_MONITORING=true
INSTALL_PYTHON_UV=true

# -----------------------------------------------------------------------------
# Versions — pin specific versions where relevant
# -----------------------------------------------------------------------------
NODE_VERSION=22                           # Major version for NodeSource repo
NOMACHINE_VERSION="8.14.2_1"              # NoMachine .deb version string
NOMACHINE_BUILD="1"                       # NoMachine build number

# -----------------------------------------------------------------------------
# vLLM Configuration
# -----------------------------------------------------------------------------
VLLM_DEFAULT_MODEL="Qwen/Qwen3-0.6B"     # Default model to serve
VLLM_PORT=8000                            # API port (bound to 127.0.0.1)
VLLM_GPU_DEVICE=0                         # GPU index for vLLM (CUDA_VISIBLE_DEVICES)
HF_TOKEN=""                               # HuggingFace token for gated models

# -----------------------------------------------------------------------------
# OpenClaw Configuration
# -----------------------------------------------------------------------------
OPENCLAW_PORT=18789                       # Gateway port
OPENCLAW_BRIDGE_PORT=18790                # Bridge port (device pairing)

# --- API Provider Keys ---
# Built-in providers — just set the key and they work automatically.
# Leave blank to skip a provider. Keys are written to ~/.openclaw/.env
ZAI_API_KEY=""                             # Z.ai API key
GEMINI_API_KEY=""                          # Google Gemini API key
HAIMAKER_API_KEY=""                        # Haimaker API key
HAIMAKER_BASE_URL=""                       # Haimaker endpoint (OpenAI-compatible)

# --- Model Routing ---
# Primary model for the default agent. Fallbacks used if primary is unavailable.
# Examples: zai/glm-4.7, google/gemini-3-pro-preview, sonnet, opus
OPENCLAW_PRIMARY_MODEL=""                  # Leave blank to use OpenClaw default
OPENCLAW_FALLBACK_MODELS=""                # Comma-separated, e.g. "google/gemini-3-pro-preview,zai/glm-4.7"

# --- Agent Migration ---
# Path to an existing ~/.openclaw/ backup to restore workspace files from.
# This imports SOUL.md, AGENTS.md, USER.md, IDENTITY.md, TOOLS.md, memory/, etc.
# Set to the path of a tar.gz archive OR a directory.
# Examples:
#   OPENCLAW_MIGRATE_FROM="/tmp/openclaw-backup.tar.gz"
#   OPENCLAW_MIGRATE_FROM="/mnt/usb/openclaw-backup/"
#   OPENCLAW_MIGRATE_FROM=""   (skip migration)
OPENCLAW_MIGRATE_FROM=""

# -----------------------------------------------------------------------------
# Portainer Configuration
# -----------------------------------------------------------------------------
PORTAINER_PORT=9443                       # HTTPS port (bound to 127.0.0.1)

# -----------------------------------------------------------------------------
# Ollama Configuration
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434                         # Ollama API port
